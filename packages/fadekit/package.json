{
  "name": "fadekit",
  "version": "0.3.0",
  "description": "Smooth, eased fades for Tailwind CSS. Gradients without the hard edge.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured yet'",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "tailwindcss",
    "tailwindcss-plugin",
    "gradient",
    "fade",
    "easing",
    "overlay",
    "scrim",
    "oklch"
  ],
  "author": "fabroos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabroos/fadekit.git"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/fabroos/fadekit#readme"
}
